# Supabase (create a NEW project just for this store)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server-only. Never prefix with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# Admin login (server-only)
ADMIN_PASSWORD=choose-a-long-random-password
# Random string, 32+ chars, e.g. `openssl rand -hex 32`
ADMIN_SESSION_SECRET=
